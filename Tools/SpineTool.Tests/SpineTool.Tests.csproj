<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="PreviewUpgradeChecks.cs" />
    <Compile Include="../SpinePreviewer/Assets/Scripts/PreviewAnimationTimeline.cs" Link="PreviewAnimationTimeline.cs" />
    <Compile Include="../SpinePreviewer/Assets/Scripts/PreviewResourceCatalog.cs" Link="PreviewResourceCatalog.cs" />
    <Compile Include="../SpinePreviewer/Assets/Scripts/PreviewManifest.cs" Link="PreviewManifest.cs" />
    <ProjectReference Include="../SpineTool/SpineTool.csproj" />
  </ItemGroup>
</Project>

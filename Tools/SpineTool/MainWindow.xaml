<Window x:Class="IdleGearDefence.SpineTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spine 导出与检查工具"
        Width="1280"
        Height="800"
        MinWidth="1080"
        MinHeight="680"
        Background="#F4F6FA"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBrush" Color="#182434" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2474D8" />
        <SolidColorBrush x:Key="TextBrush" Color="#17202C" />
        <SolidColorBrush x:Key="MutedBrush" Color="#68778C" />
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,7" /><Setter Property="Margin" Value="4" /><Setter Property="MinHeight" Value="32" /></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource AccentBrush}" /><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="#24364B" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#34506D" /></Style>
        <DataTemplate x:Key="CardTemplate">
            <Border Margin="8,5" Padding="10" CornerRadius="8" Background="#24364B" BorderBrush="#34506D" BorderThickness="1">
                <Expander Foreground="White" IsExpanded="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}">
                    <Expander.Header><DockPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock DockPanel.Dock="Right" Text="{Binding ProjectGroup}" Foreground="#8FC4FF" Margin="8,0,0,0" /></DockPanel></Expander.Header>
                    <StackPanel Margin="0,6,0,0"><TextBlock Text="{Binding Note}" Foreground="#B8C5D5" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SpineProjectPath}" Foreground="#91A3B8" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" FontSize="11" /><TextBlock Text="{Binding LastExportAt, StringFormat=上次导出：{0:yyyy-MM-dd HH:mm}}" Foreground="#B8C5D5" FontSize="11" Margin="0,4,0,0" /><TextBlock Text="{Binding LastProjectWriteTimeUtc, StringFormat=工程修改：{0:yyyy-MM-dd HH:mm}}" Foreground="#B8C5D5" FontSize="11" /></StackPanel>
                </Expander>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="240" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" MinWidth="620" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="12">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="SPINE TOOL" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="导出、检查与预览" Foreground="#9FB0C4" Margin="0,3,0,14" />
                    <Button Content="设置 Spine 程序…" Click="SelectSpineExecutable_Click" ToolTip="首次导出前，选择本机 Spine 4.1 安装目录下的 Spine.com" />
                    <TextBox x:Name="SearchTextBox" Height="34" Padding="9" ToolTip="搜索名称、备注、路径、配置名称" TextChanged="SearchTextBox_TextChanged" />
                    <TextBlock Text="所属项目" Foreground="#B8C5D5" Margin="0,7,0,0" />
                    <ComboBox x:Name="ProjectFilterComboBox" Margin="0,2,0,0" SelectionChanged="CardFilterChanged" ToolTip="按所属项目筛选" />
                    <TextBlock Text="Tag 筛选（可多选）" Foreground="#B8C5D5" Margin="0,7,0,0" />
                    <ListBox x:Name="TagFilterListBox" Height="96" Margin="0,2,0,0" SelectionMode="Multiple" SelectionChanged="CardFilterChanged" Background="#24364B" Foreground="White" BorderBrush="#34506D"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Padding="4,2" /></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <TextBlock x:Name="TagFilterEmptyTextBlock" Text="暂无 Tag；在任务卡片中保存 Tag 后可筛选" Foreground="#91A3B8" FontSize="11" Margin="4,2,0,0" />
                    <Button Content="清除筛选" Click="ClearCardFilters_Click" />
                    <Button Content="＋ 新建卡片" Style="{StaticResource SidebarButton}" Click="NewCard_Click" Margin="0,10,0,6" />
                </StackPanel>
                <ListBox x:Name="CardListBox" ItemsSource="{Binding CardsView}" SelectedValuePath="Id" SelectionChanged="CardListBox_SelectionChanged" ItemTemplate="{StaticResource CardTemplate}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>
        <GridSplitter Grid.Column="1" Grid.Row="0" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#AAB7C7" ShowsPreview="True" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" />
        <TabControl x:Name="MainTabs" Grid.Column="2" Grid.Row="0" Margin="24,20,24,12">
            <TabItem x:Name="ProjectTab" Header="Spine 工程">
        <Grid Margin="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel><TextBlock Text="当前任务" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <WrapPanel HorizontalAlignment="Right"><Button Content="置顶" Click="PinCard_Click" /><Button Content="另存为" Click="SaveAsCard_Click" /><Button Content="删除" Click="DeleteCard_Click" /><Button Content="保存卡片" Style="{StaticResource PrimaryButton}" Click="SaveCard_Click" /></WrapPanel>
                </DockPanel>
                <TextBlock x:Name="CardStateTextBlock" Grid.Row="1" Text="选择或新建一张卡片" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="卡片名称" VerticalAlignment="Center" /><TextBox x:Name="CardNameTextBox" Grid.Row="1" Grid.Column="1" Margin="8,4" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="卡片备注" VerticalAlignment="Top" Margin="0,10,0,0" /><TextBox x:Name="CardNoteTextBox" Grid.Row="2" Grid.Column="1" Margin="8,4" Height="54" AcceptsReturn="True" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Spine 工程" VerticalAlignment="Center" /><TextBox x:Name="ProjectPathTextBox" Grid.Row="3" Grid.Column="1" Margin="8,4" ToolTip="可拖入 Spine 工程文件夹或 .spine 文件" TextChanged="PathTextBox_TextChanged" /><StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal"><Button Content="选择" Click="BrowseProject_Click" /><Button Content="目录" Click="OpenProjectDirectory_Click" /></StackPanel>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Tag" VerticalAlignment="Center" /><TextBox x:Name="ProjectTagsTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,4" ToolTip="多个 Tag 用逗号分隔" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="所属项目" VerticalAlignment="Center" /><TextBox x:Name="ProjectGroupTextBox" Grid.Row="5" Grid.Column="1" Margin="8,4" Text="齿轮项目" />
            <TextBlock Grid.Row="6" Text="导出配置" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox x:Name="TaskExportConfigComboBox" Grid.Row="6" Grid.Column="1" Margin="8,4" MinHeight="28" DisplayMemberPath="Name" SelectionChanged="TaskConfiguration_SelectionChanged" />
            <Button Grid.Row="6" Grid.Column="2" Content="管理导出配置" Click="ManageExportConfig_Click" />
            <TextBlock Grid.Row="7" Text="验证规则" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox x:Name="TaskValidationRuleComboBox" Grid.Row="7" Grid.Column="1" Margin="8,4" MinHeight="28" DisplayMemberPath="Name" SelectionChanged="TaskConfiguration_SelectionChanged" />
            <Button Grid.Row="7" Grid.Column="2" Content="管理验证规则" Click="ManageValidationRule_Click" />
            <Expander Grid.Row="8" Grid.ColumnSpan="3" Header="配置详情" IsExpanded="False" Margin="0,8,0,0">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Text="导出配置" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBox x:Name="ExportConfigNameTextBox" Grid.Row="0" Grid.Column="1" Margin="8,4" IsReadOnly="True" /><TextBox x:Name="ExporterConfigTextBox" Grid.Row="0" Grid.Column="2" Margin="8,4" IsReadOnly="True" TextChanged="PathTextBox_TextChanged" />
                    <TextBlock x:Name="ExporterConfigStatusTextBlock" Grid.Row="1" Grid.ColumnSpan="3" Margin="8,0,8,5" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Text="检查规则" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBox x:Name="ValidationRulesNameTextBox" Grid.Row="2" Grid.Column="1" Margin="8,4" IsReadOnly="True" /><TextBox x:Name="ValidatorRulesTextBox" Grid.Row="2" Grid.Column="2" Margin="8,4" IsReadOnly="True" TextChanged="PathTextBox_TextChanged" />
                    <TextBlock x:Name="ValidatorRulesStatusTextBlock" Grid.Row="3" Grid.ColumnSpan="3" Margin="8,0,8,5" FontSize="11" TextWrapping="Wrap" />
                    <TextBox x:Name="ExportConfigNoteTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,2" MinHeight="24" IsReadOnly="True" TextWrapping="Wrap" ToolTip="导出配置备注" />
                    <TextBox x:Name="ValidationRulesNoteTextBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,2" MinHeight="24" IsReadOnly="True" TextWrapping="Wrap" ToolTip="验证规则备注" />
                </Grid>
            </Expander>
            <Grid Grid.Row="9" Grid.ColumnSpan="3" Margin="0,15,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="输出根目录" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="OutputPathComboBox" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False" Margin="4" MinHeight="28" ToolTip="点击选择历史输出根目录，也可直接输入路径" PreviewMouseLeftButtonDown="OutputPathComboBox_PreviewMouseLeftButtonDown" LostKeyboardFocus="OutputPathComboBox_LostKeyboardFocus" />
                        <Button Grid.Column="2" Content="选择目录" Click="BrowseOutput_Click" /><Button Grid.Column="3" Content="打开输出目录" Click="OpenOutputDirectory_Click" ToolTip="打开当前工程在输出根目录下的资源文件夹" />
                    </Grid>
                    <WrapPanel Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal"><Button Content="导出" Style="{StaticResource PrimaryButton}" Click="ExportOnly_Click" /><Button Content="验证" Click="ValidateOnly_Click" /><Button Content="预览" Click="PreviewOnly_Click" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="8,0"><CheckBox x:Name="ExportToggle" Content="导出" IsChecked="True" VerticalAlignment="Center" Margin="4" /><CheckBox x:Name="ValidateToggle" Content="验证" IsChecked="True" VerticalAlignment="Center" Margin="4" /><CheckBox x:Name="PreviewToggle" Content="预览" IsChecked="True" VerticalAlignment="Center" Margin="4" /><Button Content="一键执行" Style="{StaticResource PrimaryButton}" Click="RunSelectedOperations_Click" /></StackPanel>
                        <ComboBox x:Name="PreviewModeComboBox" Width="145" Margin="4" SelectedIndex="0" ToolTip="预览显示模式"><ComboBoxItem Content="SkeletonAnimation" /><ComboBoxItem Content="SkeletonGraphic" /></ComboBox>
                    </WrapPanel>
                </StackPanel>
                <TabControl Grid.Row="1" Margin="0,10,0,0">
                    <TabItem Header="日志"><TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" /></TabItem>
                </TabControl>
            </Grid>
        </Grid>
            </TabItem>
            <TabItem x:Name="ExportConfigurationTab" Header="导出配置">
                <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="190" MinWidth="140" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" MinWidth="280" /></Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,10,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="导出配置" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="美术维护导出与图集参数" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10" /><Button Content="＋ 从当前配置新建" Click="NewExportConfig_Click" /><Button Content="导入导出配置…" Click="ImportExportConfig_Click" /></StackPanel><ListBox x:Name="ExportConfigListBox" Margin="0,10,0,0" DisplayMemberPath="Name" SelectionChanged="ExportConfigListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" /></DockPanel>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#D7DFEA" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="14,0,0,0"><StackPanel>
                        <WrapPanel><Button x:Name="SaveExportConfigButton" Content="保存导出配置" Style="{StaticResource PrimaryButton}" Click="SaveExportConfig_Click" /><Button Content="导出分享文件…" Click="ShareExportConfig_Click" /><Button Content="删除配置" Click="DeleteExportConfig_Click" /></WrapPanel>
                        <TextBlock Text="名称" Margin="0,12,0,4" /><TextBox x:Name="ExportEditorNameTextBox" MinHeight="28" />
                        <Expander Header="配置说明" Margin="0,8,0,0"><TextBox x:Name="ExportEditorNoteTextBox" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" Margin="8" /></Expander>
                        <TextBlock x:Name="ExportSettingsStatusTextBlock" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        <Border Background="#EDF5FF" BorderBrush="#B6D4F5" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,12,0,14"><StackPanel>
                            <TextBlock Text="常用配置" FontWeight="SemiBold" FontSize="15" Margin="4,0,0,6" />
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="4,2,14,2"><TextBlock Text="缩放" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBox x:Name="PackScaleTextBox" Width="80" MinHeight="28" Padding="5,2" VerticalContentAlignment="Center" /></StackPanel>
<CheckBox x:Name="PremultiplyAlphaCheckBox" Content="预乘 Alpha" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackBleedCheckBox" Content="溢出（Bleed）" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackMultipleOfFourCheckBox" Content="能被 4 整除" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackSquareCheckBox" Content="正方形" Margin="4,5,10,5" VerticalAlignment="Center" /></WrapPanel>
                            <TextBlock Text="缩放 0.5 = 原尺寸的一半；这里与下方同名选项同步。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,6,4,0" />
                        </StackPanel></Border>
                        <TextBlock Text="纹理打包器设置" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <WrapPanel>
<GroupBox Header="区域" Width="278" Margin="0,0,12,12" VerticalAlignment="Top"><StackPanel Margin="8"><WrapPanel><CheckBox x:Name="PackStripWhitespaceXCheckBox" Content="去除 X 轴空白区" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackStripWhitespaceYCheckBox" Content="去除 Y 轴空白区" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackRotationCheckBox" Content="旋转" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackAliasCheckBox" Content="别名" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackIgnoreBlankCheckBox" Content="忽略空白图片" Margin="4,5,10,5" VerticalAlignment="Center" /></WrapPanel><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Alpha 阈值" VerticalAlignment="Center" /><Border Grid.Column="1"><TextBox x:Name="PackAlphaThresholdTextBox" MinHeight="26" Padding="5,2" VerticalContentAlignment="Center" /></Border></Grid></StackPanel></GroupBox><GroupBox Header="区域填充" Width="278" Margin="0,0,12,12" VerticalAlignment="Top"><StackPanel Margin="8"><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="填充 X" VerticalAlignment="Center" /><Border Grid.Column="1"><TextBox x:Name="PackPaddingXTextBox" MinHeight="26" Padding="5,2" VerticalContentAlignment="Center" /></Border></Grid><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="填充 Y" VerticalAlignment="Center" /><Border Grid.Column="1"><TextBox x:Name="PackPaddingYTextBox" MinHeight="26" Padding="5,2" VerticalContentAlignment="Center" /></Border></Grid><WrapPanel><CheckBox x:Name="PackEdgePaddingCheckBox" Content="边缘填充" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackDuplicatePaddingCheckBox" Content="复制填充" Margin="4,5,10,5" VerticalAlignment="Center" /></WrapPanel></StackPanel></GroupBox><GroupBox Header="页面" Width="278" Margin="0,0,12,12" VerticalAlignment="Top"><StackPanel Margin="8"><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="最小宽度" VerticalAlignment="Center" /><Border Grid.Column="1"><TextBox x:Name="PackMinWidthTextBox" MinHeight="26" Padding="5,2" VerticalContentAlignment="Center" /></Border></Grid><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="最小高度" VerticalAlignment="Center" /><Border Grid.Column="1"><TextBox x:Name="PackMinHeightTextBox" MinHeight="26" Padding="5,2" VerticalContentAlignment="Center" /></Border></Grid><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="最大宽度" VerticalAlignment="Center" /><Border Grid.Column="1"><TextBox x:Name="PackMaxWidthTextBox" MinHeight="26" Padding="5,2" VerticalContentAlignment="Center" /></Border></Grid><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="最大高度" VerticalAlignment="Center" /><Border Grid.Column="1"><TextBox x:Name="PackMaxHeightTextBox" MinHeight="26" Padding="5,2" VerticalContentAlignment="Center" /></Border></Grid><WrapPanel><CheckBox x:Name="PackPowerOfTwoCheckBox" Content="2 的幂数" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackMultipleOfFourDetailCheckBox" IsChecked="{Binding IsChecked, ElementName=PackMultipleOfFourCheckBox, Mode=TwoWay}" Content="能被 4 整除" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackSquareDetailCheckBox" IsChecked="{Binding IsChecked, ElementName=PackSquareCheckBox, Mode=TwoWay}" Content="正方形" Margin="4,5,10,5" VerticalAlignment="Center" /></WrapPanel></StackPanel></GroupBox><GroupBox Header="运行时" Width="278" Margin="0,0,12,12" VerticalAlignment="Top"><StackPanel Margin="8"><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="过滤缩小" VerticalAlignment="Center" /><Border Grid.Column="1"><ComboBox x:Name="PackFilterMinComboBox" MinHeight="26"><ComboBoxItem Content="Linear" /><ComboBoxItem Content="Nearest" /><ComboBoxItem Content="MipMapLinearLinear" /></ComboBox></Border></Grid><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="过滤放大" VerticalAlignment="Center" /><Border Grid.Column="1"><ComboBox x:Name="PackFilterMagComboBox" MinHeight="26"><ComboBoxItem Content="Linear" /><ComboBoxItem Content="Nearest" /></ComboBox></Border></Grid><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="包裹 X" VerticalAlignment="Center" /><Border Grid.Column="1"><ComboBox x:Name="PackWrapXComboBox" MinHeight="26"><ComboBoxItem Content="ClampToEdge" /><ComboBoxItem Content="Repeat" /><ComboBoxItem Content="MirroredRepeat" /></ComboBox></Border></Grid><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="包裹 Y" VerticalAlignment="Center" /><Border Grid.Column="1"><ComboBox x:Name="PackWrapYComboBox" MinHeight="26"><ComboBoxItem Content="ClampToEdge" /><ComboBoxItem Content="Repeat" /><ComboBoxItem Content="MirroredRepeat" /></ComboBox></Border></Grid><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="格式" VerticalAlignment="Center" /><Border Grid.Column="1"><ComboBox x:Name="PackPixelFormatComboBox" MinHeight="26"><ComboBoxItem Content="RGBA8888" /><ComboBoxItem Content="RGBA4444" /><ComboBoxItem Content="RGB888" /><ComboBoxItem Content="RGB565" /></ComboBox></Border></Grid></StackPanel></GroupBox><GroupBox Header="输出" Width="278" Margin="0,0,12,12" VerticalAlignment="Top"><StackPanel Margin="8"><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="输出格式" VerticalAlignment="Center" /><Border Grid.Column="1"><ComboBox MinHeight="26" SelectedIndex="0" IsEnabled="False"><ComboBoxItem Content="PNG" /></ComboBox></Border></Grid><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="打包" VerticalAlignment="Center" /><Border Grid.Column="1"><ComboBox x:Name="PackPackingComboBox" MinHeight="26"><ComboBoxItem Content="rectangles" /><ComboBoxItem Content="polygons" /></ComboBox></Border></Grid><WrapPanel><CheckBox x:Name="PackPmaDetailCheckBox" IsChecked="{Binding IsChecked, ElementName=PremultiplyAlphaCheckBox, Mode=TwoWay}" Content="预乘 Alpha" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackBleedDetailCheckBox" IsChecked="{Binding IsChecked, ElementName=PackBleedCheckBox, Mode=TwoWay}" Content="溢出（Bleed）" Margin="4,5,10,5" VerticalAlignment="Center" /></WrapPanel><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="缩放" VerticalAlignment="Center" /><Border Grid.Column="1"><TextBox x:Name="PackScaleDetailTextBox" Text="{Binding Text, ElementName=PackScaleTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="26" Padding="5,2" VerticalContentAlignment="Center" /></Border></Grid></StackPanel></GroupBox><GroupBox Header="选项" Width="278" Margin="0,0,12,12" VerticalAlignment="Top"><StackPanel Margin="8"><Grid Margin="4,4"><Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="图集扩展名" VerticalAlignment="Center" /><Border Grid.Column="1"><ComboBox x:Name="PackAtlasExtensionComboBox" MinHeight="26"><ComboBoxItem Content=".atlas.txt" /><ComboBoxItem Content=".atlas" /></ComboBox></Border></Grid><WrapPanel><CheckBox x:Name="PackFlattenPathsCheckBox" Content="去除路径" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackIndexesCheckBox" Content="使用索引" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackDebugCheckBox" Content="调试" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackFastCheckBox" Content="快速" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackLimitMemoryCheckBox" Content="有限内存" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="PackPrettyPrintCheckBox" Content="优质打印" Margin="4,5,10,5" VerticalAlignment="Center" /></WrapPanel></StackPanel></GroupBox></WrapPanel>
                        <Expander Header="数据导出选项" Margin="0,0,0,10"><WrapPanel Margin="8"><CheckBox x:Name="JsonNonessentialCheckBox" Content="JSON 非必要数据" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="JsonPrettyPrintCheckBox" Content="JSON 优质打印" Margin="4,5,10,5" VerticalAlignment="Center" /><CheckBox x:Name="BinaryNonessentialCheckBox" Content="Binary 非必要数据" Margin="4,5,10,5" VerticalAlignment="Center" /></WrapPanel></Expander>
                        <Expander Header="配置文件位置" Margin="0,14,0,12"><StackPanel Margin="8"><TextBox x:Name="ExportEditorPathTextBox" IsReadOnly="True" TextWrapping="Wrap" /><Button Content="打开配置目录" HorizontalAlignment="Left" Click="OpenExportEditorDirectory_Click" /></StackPanel></Expander>
                    </StackPanel></ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="ValidationConfigurationTab" Header="验证规则">
                <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="190" MinWidth="140" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" MinWidth="280" /></Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,10,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="验证规则" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="规范独立维护，可单独发给美术" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10" /><Button Content="＋ 从当前规则新建" Click="NewValidationRule_Click" /><Button Content="导入验证规则…" Click="ImportValidationRule_Click" /></StackPanel><ListBox x:Name="ValidationRuleListBox" Margin="0,10,0,0" DisplayMemberPath="Name" SelectionChanged="ValidationRuleListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" /></DockPanel>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#D7DFEA" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="14,0,0,0"><StackPanel>
                        <WrapPanel><Button x:Name="SaveValidationRuleButton" Content="保存验证规则" Style="{StaticResource PrimaryButton}" Click="SaveValidationRule_Click" /><Button Content="导出分享文件…" Click="ShareValidationRule_Click" /><Button Content="删除规则" Click="DeleteValidationRule_Click" /></WrapPanel>
                        <TextBlock Text="名称" Margin="0,12,0,4" /><TextBox x:Name="RuleEditorNameTextBox" MinHeight="28" />
                        <TextBlock Text="说明" Margin="0,10,0,4" /><TextBox x:Name="RuleEditorNoteTextBox" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,10,0,0"><CheckBox x:Name="RulesEnabledCheckBox" Content="启用验证" Margin="0,6,16,6" /><CheckBox x:Name="RulesFailureDialogCheckBox" Content="阻断错误弹窗" Margin="0,6,16,6" /></WrapPanel>
                        <GroupBox Header="必须满足的规范（不满足时阻断）" Margin="0,10,0,0"><StackPanel Margin="10"><TextBlock Text="多个名称用逗号或换行分隔；留空表示不要求。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="必需动画" Margin="0,10,0,4" /><TextBox x:Name="RequiredAnimationsTextBox" MinHeight="28" /><TextBlock Text="必需骨骼" Margin="0,10,0,4" /><TextBox x:Name="RequiredBonesTextBox" MinHeight="28" /><TextBlock Text="必需插槽" Margin="0,10,0,4" /><TextBox x:Name="RequiredSlotsTextBox" MinHeight="28" /></StackPanel></GroupBox>
                        <GroupBox Header="骨骼提醒（不阻断）" Margin="0,10,0,0"><StackPanel Margin="10"><TextBlock Text="缺少这些骨骼时只在日志输出 Warning" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /><TextBox x:Name="WarningBonesTextBox" MinHeight="28" Margin="0,6,0,0" /></StackPanel></GroupBox>
                        <GroupBox Header="动画事件规范" Margin="0,10,0,0"><StackPanel Margin="10"><TextBlock Text="每行指定动画与事件。可在最后一行添加，选中行后按 Delete 删除。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" /><DataGrid x:Name="EventRulesDataGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" MinHeight="120" MaxHeight="260" Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="动画" Binding="{Binding Animation}" Width="*" MinWidth="90" /><DataGridTextColumn Header="事件" Binding="{Binding EventName}" Width="*" MinWidth="90" /><DataGridTextColumn Header="最少次数" Binding="{Binding MinCount}" Width="75" /><DataGridTextColumn Header="最多次数" Binding="{Binding MaxCount}" Width="75" /><DataGridTextColumn Header="时间(秒)" Binding="{Binding ExpectedTime}" Width="75" /><DataGridTextColumn Header="时间容差" Binding="{Binding TimeTolerance}" Width="75" /></DataGrid.Columns></DataGrid></StackPanel></GroupBox>
                        <Expander Header="文件与版本要求" Margin="0,12,0,0"><StackPanel Margin="10"><WrapPanel>
<StackPanel Width="220" Margin="0,0,12,10"><TextBlock Text="数据版本（如 4.1；留空不限制）" Margin="0,0,0,4" /><TextBox x:Name="RulesVersionTextBox" MinHeight="28" /></StackPanel><StackPanel Width="220" Margin="0,0,12,10"><TextBlock Text="资源名正则（留空不限制）" Margin="0,0,0,4" /><TextBox x:Name="RulesNamingTextBox" MinHeight="28" /></StackPanel></WrapPanel><TextBlock Text="文件项：勾选 = 必需，取消 = 不要求，横线 = 使用验证器默认值。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" /><WrapPanel><CheckBox x:Name="RulesRequireJsonCheckBox" IsThreeState="True" Content="JSON" Margin="0,6,16,6" VerticalAlignment="Center" /><CheckBox x:Name="RulesRequireBinaryCheckBox" IsThreeState="True" Content="Binary" Margin="0,6,16,6" VerticalAlignment="Center" /><CheckBox x:Name="RulesRequireAtlasCheckBox" IsThreeState="True" Content="Atlas" Margin="0,6,16,6" VerticalAlignment="Center" /><CheckBox x:Name="RulesRequireTexturesCheckBox" IsThreeState="True" Content="纹理图片" Margin="0,6,16,6" VerticalAlignment="Center" /></WrapPanel></StackPanel></Expander>
                        <TextBlock x:Name="RulesEditorStatusTextBlock" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                        <Expander Header="规则文件位置" Margin="0,14,0,12"><StackPanel Margin="8"><TextBox x:Name="RuleEditorPathTextBox" IsReadOnly="True" TextWrapping="Wrap" /><Button Content="打开规则目录" HorizontalAlignment="Left" Click="OpenRuleEditorDirectory_Click" /></StackPanel></Expander>
                    </StackPanel></ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="批量验证">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <TextBlock Text="资源根目录" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="BatchRootTextBox" Width="360" Margin="4" /><Button Content="选择目录" Click="BrowseBatchRoot_Click" /><Button Content="开始批量检查" Style="{StaticResource PrimaryButton}" Click="BatchValidate_Click" /><Button x:Name="BatchCancelButton" Content="取消" IsEnabled="False" Click="CancelOperation_Click" /><Button Content="保存汇总报告" Click="SaveBatchReport_Click" /><CheckBox x:Name="BatchFailuresOnlyCheckBox" Content="只看失败" VerticalAlignment="Center" Margin="10,4" Checked="BatchFilterChanged" Unchecked="BatchFilterChanged" />
                    </WrapPanel>
                    <DataGrid x:Name="BatchDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,12" MouseDoubleClick="BatchDataGrid_MouseDoubleClick">
                        <DataGrid.Columns><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90" /><DataGridTextColumn Header="资源" Binding="{Binding Resource.ResourceName}" Width="170" /><DataGridTextColumn Header="目录" Binding="{Binding Resource.Directory}" Width="*" /><DataGridTextColumn Header="Blocker" Binding="{Binding BlockerCount}" Width="70" /><DataGridTextColumn Header="Warning" Binding="{Binding WarningCount}" Width="70" /><DataGridTemplateColumn Header="操作" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="预览" Click="BatchPreview_Click" /><Button Content="目录" Click="BatchOpenDirectory_Click" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>        </TabControl>
        <Border Grid.ColumnSpan="3" Grid.Row="1" Background="#E7ECF3" Padding="16,8"><DockPanel><TextBlock x:Name="StatusTextBlock" Text="就绪" Foreground="#40546D" VerticalAlignment="Center" /><ProgressBar x:Name="ProgressBar" DockPanel.Dock="Right" Width="220" Height="8" IsIndeterminate="False" /></DockPanel></Border>
    </Grid>
</Window>










